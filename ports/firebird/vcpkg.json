{
  "name": "firebird",
  "version-semver": "5.0.5",
  "description": "Firebird SQL DBMS client library",
  "homepage": "https://firebirdsql.org/",
  "license": "LicenseRef-IDPL OR LicenseRef-IPL",
  "supports": "(windows & !uwp & !arm32) | linux | osx",
  "dependencies": [
    "boost-preprocessor",
    {
      "name": "icu",
      "host": true,
      "default-features": false
    },
    "libtommath",
    {
      "name": "ncurses",
      "host": true,
      "platform": "!windows"
    },
    {
      "name": "re2",
      "host": true
    },
    {
      "name": "zlib",
      "host": true,
      "platform": "linux | windows"
    }
  ],
  "features": {
    "chacha": {
      "description": "Build the ChaCha wire encryption plugin",
      "supports": "!(windows & arm64)",
      "dependencies": [
        "libtomcrypt"
      ]
    }
  }
}
