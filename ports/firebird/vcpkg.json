{
  "name": "firebird",
  "version-semver": "5.0.4",
  "port-version": 2,
  "description": "Firebird SQL DBMS client library",
  "homepage": "https://firebirdsql.org/",
  "license": "LicenseRef-IDPL OR LicenseRef-IPL",
  "supports": "(windows & !uwp) | linux | osx",
  "dependencies": [
    {
      "name": "icu",
      "host": true,
      "default-features": false
    },
    {
      "name": "libtommath",
      "platform": "!windows | (windows & static)"
    },
    {
      "name": "ncurses",
      "host": true,
      "platform": "!windows"
    },
    {
      "name": "zlib",
      "host": true,
      "platform": "linux"
    }
  ],
  "features": {
    "chacha": {
      "description": "Build the ChaCha wire encryption plugin",
      "dependencies": [
        "libtomcrypt"
      ]
    }
  }
}
